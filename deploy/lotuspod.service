[Unit]
Description=Lotuspod allow-listed artifact server (publish port 8622)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Repo-local venv install (pip install -e .) with WorkingDirectory set.
# Adjust both paths to your layout; the port MUST match deploy/cloudflared.yml.
WorkingDirectory=%h/srv/dev/lotuspod
ExecStart=%h/srv/dev/lotuspod/.venv/bin/lotuspod serve --host 127.0.0.1 --port 8622
Restart=on-failure
RestartSec=5

# Hardening: loopback-only listener, no new privileges, private tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
