# The deploy's settings, read by lotuspod-deploy.service as EnvironmentFile=
# %h/.config/lotuspod/deploy.env (the operator's config directory on the
# writer host). Copy this file there and fill in the placeholders. systemd
# reads it as KEY=value lines, with no shell expansion.

# The site checkout: a clone kept on main and never edited by hand.
LOTUSPOD_SITE=/path/to/site-checkout
# Its virtual environment's python.
LOTUSPOD_PYTHON=/path/to/site-checkout/.venv/bin/python
# The serve and responder units, restarted after each fast-forward.
LOTUSPOD_UNITS=lotuspod.service lotuspod-respond.service
# Serve's loopback port; it must match the serve unit and cloudflared.yml.
LOTUSPOD_PORT=8622
# The public URL, which must not answer 200 to a reader without credentials.
LOTUSPOD_PUBLIC_URL=https://site.example/
# Where a failed deploy writes its note.
LOTUSPOD_NOTES=/path/to/notes

# Optional: the three commands the deploy runs, as shell commands in the site
# checkout. Unset, they are:
#   reinstall  $LOTUSPOD_PYTHON -m pip install -e $LOTUSPOD_SITE
#   restart    systemctl --user restart $LOTUSPOD_UNITS
#   check      python3 $LOTUSPOD_SITE/deploy/lotuspod-health.py
#LOTUSPOD_DEPLOY_REINSTALL=
#LOTUSPOD_DEPLOY_RESTART=
#LOTUSPOD_DEPLOY_CHECK=
