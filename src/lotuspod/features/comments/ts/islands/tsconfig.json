{
  // The islands: modules with imports, bundled with Preact into one script
  // (web/build.ts), JSX through Preact's automatic runtime. The DOM's types
  // and none of Bun's, as for the per-file sources in ../. Preact is
  // installed in web/node_modules, so "paths" finds it there.
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "preact": ["../../../../../../web/node_modules/preact"],
      "preact/*": ["../../../../../../web/node_modules/preact/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
