{
  // The browser sources, here and in each slice's ts/ (built beside it by
  // web/build.ts): the DOM's types and none of Bun's. The empty
  // "references" keeps tsc from failing while no source is converted yet.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "../../src/lotuspod/features/*/ts/*.ts"],
  "references": []
}
